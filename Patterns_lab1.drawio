<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36" version="27.0.5">
  <diagram name="Page-1" id="Kyaxn55yQL5VF7HTtVZG">
    <mxGraphModel dx="2528" dy="3084" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEF\n  BorderColor #333\n  ArrowColor #3366FF\n}\n\nactor \&quot;HR Manager\&quot; as HR\nactor \&quot;New Employee\&quot; as Employee\nactor \&quot;IT Administrator\&quot; as IT\n\nrectangle \&quot;Onboarding System\&quot; {\n    usecase \&quot;Fill Personal Information\&quot; as UC1\n    usecase \&quot;Sign Employment Documents\&quot; as UC2\n    usecase \&quot;Attend Orientation\&quot; as UC3\n    usecase \&quot;Create User Account\&quot; as UC4\n    usecase \&quot;Grant System Access\&quot; as UC5\n    usecase \&quot;Assign Mentor\&quot; as UC6\n    usecase \&quot;Complete Mandatory Training\&quot; as UC7\n    usecase \&quot;Set Up Workstation\&quot; as UC8\n    usecase \&quot;Schedule Intro Meetings\&quot; as UC9\n\n    UC7 .&gt; UC3 : &lt;&lt;include&gt;&gt;\n    UC3 .&gt; UC2 : &lt;&lt;include&gt;&gt;\n    UC5 .&gt; UC4 : &lt;&lt;include&gt;&gt;\n    UC6 .&gt; UC3 : &lt;&lt;extend&gt;&gt;\n    UC9 .&gt; UC3 : &lt;&lt;extend&gt;&gt;\n}\n\nHR --&gt; UC2 : Reviews\nHR --&gt; UC6 : Assigns\nHR --&gt; UC9 : Organizes\n\nEmployee --&gt; UC1\nEmployee --&gt; UC2\nEmployee --&gt; UC3\nEmployee --&gt; UC7\n\nIT --&gt; UC4\nIT --&gt; UC5\nIT --&gt; UC8\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="sU30GJXYZb531qB-KXTN-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-300" y="-90" width="483" height="756" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam class {\n    BackgroundColor #EEF\n    BorderColor #333\n}\n\nclass Employee {\n    +name: String\n    +position: String\n    +startDate: Date\n}\n\nclass HRManager {\n    +name: String\n    +assignMentor(employee: Employee): void\n    +scheduleIntroduction(employee: Employee): void\n}\n\nclass ITAdministrator {\n    +name: String\n    +createAccount(employee: Employee): void\n    +setupWorkstation(employee: Employee): void\n}\n\nclass UserAccount {\n    +username: String\n    +email: String\n    +temporaryPassword: String\n}\n\nclass Workstation {\n    +id: String\n    +location: String\n    +operatingSystem: String\n}\n\nclass Mentor {\n    +name: String\n    +department: String\n}\n\nEmployee *-- UserAccount : creates\nEmployee *-- Workstation : assigned\nEmployee o-- Mentor : optionally assigned\n\nHRManager -- Employee : manages\nITAdministrator -- Employee : supports\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="sU30GJXYZb531qB-KXTN-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="230" y="-110" width="717" height="442" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n\n:Employee arrives at reception;\n\nrepeat\n  if (Has ID/passport?) then (yes)\n    :Proceed to HR;\n  else (no)\n    :Wait or go home to get it;\n  endif\nrepeat while (Has ID/passport? == no)\n\nrepeat\n  :Sign employment documents;\n  if (Documents complete?) then (yes)\n    :Receive employee badge;\n  else (no)\n    :Contact HR for assistance;\n  endif\nrepeat while (Documents complete? == no)\n\n:Attend mandatory safety briefing;\n\nrepeat\n  :Meet IT administrator;\n  if (Workstation ready?) then (yes)\n    :Receive workstation;\n    :Receive email and system credentials;\n  else (no)\n    :Temporary laptop provided;\n    :Credentials will be emailed;\n  endif\nrepeat while (Workstation ready? == no)\n\nrepeat\n  :Log in to system;\n  if (Login successful?) then (yes)\n    :Check email;\n  else (no)\n    :Call IT support;\n  endif\nrepeat while (Login successful? == no)\n\n:Join team introduction meeting;\n\nrepeat\n  if (Mentor assigned?) then (yes)\n    :Meet mentor;\n    :Receive onboarding checklist;\n  else (no)\n    :Ask HR about mentorship;\n  endif\nrepeat while (Mentor assigned? == no)\n\nrepeat\n  if (Training session available?) then (yes)\n    :Attend initial training;\n  else (no)\n    :Read internal documentation;\n  endif\nrepeat while (Training session available? == no)\n\n:Day 1 feedback form (optional);\n\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="sU30GJXYZb531qB-KXTN-12">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="1010" y="-1140" width="496" height="1797" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nactor User\n\nparticipant \&quot;SAP SuccessFactors\&quot; as SF\nparticipant \&quot;Reporting System\&quot; as Reporting\nparticipant \&quot;Compensation System\&quot; as Compensation\nparticipant \&quot;Leave Management System\&quot; as Leave\nparticipant \&quot;LMS System\&quot; as LMS\n\n== Process Start ==\nUser -&gt; SF : Request employee onboarding data\nactivate SF\nactivate User\n\nSF -&gt; Reporting : Send onboarding report\nactivate Reporting\nReporting --&gt; SF : Acknowledge report received\ndeactivate Reporting\n\nSF -&gt; Compensation : Send salary and bonus data\nactivate Compensation\nCompensation --&gt; SF : Confirm compensation update\ndeactivate Compensation\n\nSF -&gt; Leave : Update leave balances\nactivate Leave\nLeave --&gt; SF : Confirm leave update\ndeactivate Leave\n\nSF -&gt; LMS : Enroll employee in training courses\nactivate LMS\nLMS --&gt; SF : Confirm enrollment\ndeactivate LMS\n\nSF -&gt; User : Provide onboarding status and confirmations\ndeactivate SF\ndeactivate User\n== Process End ==\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="sU30GJXYZb531qB-KXTN-13">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-40" y="800" width="1056" height="542" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
